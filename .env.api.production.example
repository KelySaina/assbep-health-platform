# Oracle VM backend deployment example
# Copy to .env.api.production before running docker compose -f docker-compose.api.yml

POSTGRES_USER=assbep_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
POSTGRES_DB=assbep_health
DATABASE_URL=postgresql://assbep_prod_user:CHANGE_THIS_DATABASE_PASSWORD@postgres:5432/assbep_health?schema=public

JWT_SECRET=CHANGE_THIS_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
SESSION_SECRET=CHANGE_THIS_LONG_RANDOM_SESSION_SECRET

API_PORT=4000
API_HOSTNAME=YOUR_ORACLE_PUBLIC_IP.sslip.io
CORS_ORIGIN=https://your-public-project.vercel.app,https://your-admin-project.vercel.app,https://your-public-project-*.vercel.app,https://your-admin-project-*.vercel.app

MINIO_ROOT_USER=assbep-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_THIS_MINIO_ADMIN_PASSWORD
MINIO_ACCESS_KEY=assbep-minio-admin
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_ADMIN_PASSWORD
MINIO_BUCKET=assbep-media
MINIO_PUBLIC_URL=https://YOUR_ORACLE_PUBLIC_IP.sslip.io/storage

LOG_LEVEL=warn
DATABASE_LOGGING=false
MAX_FILE_SIZE=20971520
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=60

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=