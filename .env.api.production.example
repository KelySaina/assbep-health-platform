# Oracle VM backend deployment example
# Copy to .env.api.production before running docker compose -f docker-compose.api.yml

POSTGRES_USER=assbep_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
POSTGRES_DB=assbep_health
DATABASE_URL=postgresql://assbep_prod_user:CHANGE_THIS_DATABASE_PASSWORD@postgres:5432/assbep_health?schema=public

JWT_SECRET=CHANGE_THIS_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
SESSION_SECRET=CHANGE_THIS_LONG_RANDOM_SESSION_SECRET

API_PORT=4000
API_HOSTNAME=api.assbep.75-119-136-160.nip.io
CORS_ORIGIN=https://your-public-project.vercel.app,https://your-admin-project.vercel.app,https://your-public-project-*.vercel.app,https://your-admin-project-*.vercel.app

MINIO_ROOT_USER=assbep-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_THIS_MINIO_ADMIN_PASSWORD
MINIO_ACCESS_KEY=assbep-minio-admin
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_ADMIN_PASSWORD
MINIO_BUCKET=assbep-media
MINIO_PUBLIC_URL=https://api.assbep.75-119-136-160.nip.io/storage

LOG_LEVEL=warn
DATABASE_LOGGING=false
MAX_FILE_SIZE=20971520
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=60

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Host ports (the reverse proxy is a Caddy on the host, not in this stack) ──
# Caddy reaches the API and MinIO through these published ports. 127.0.0.1 is
# what makes the proxy the only way in: on 0.0.0.0 both answer in plain http
# alongside the TLS Caddy sets up. Postgres is not published at all.
BIND_HOST=127.0.0.1
API_HOST_PORT=4100
MINIO_HOST_PORT=9100
# Published for an SSH tunnel only; routed nowhere.
MINIO_CONSOLE_HOST_PORT=9101

# MINIO_PUBLIC_URL above must be https://<API_HOSTNAME>/storage — that is the
# path Caddy serves uploads from. Point it anywhere else and uploads appear to
# succeed while every document 404s in the browser.
