# =============================================================================
# ASSBEP Health Platform - Environment Variables
# =============================================================================
# Copy this file to .env and update the values for your environment
# For production, use .env.production with secure values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=assbep_user
POSTGRES_PASSWORD=assbep_password_2024
POSTGRES_DB=assbep_health
POSTGRES_PORT=5432

# Database URL for Prisma (used by API)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# =============================================================================
# MINIO CONFIGURATION (S3-Compatible Storage)
# =============================================================================
# MinIO Access Credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MinIO Endpoint (internal Docker network)
MINIO_ENDPOINT=minio:9000

# MinIO Port
MINIO_PORT=9000

# MinIO Use SSL (false for local, true for production)
MINIO_USE_SSL=false

# MinIO Access Key (for API to connect)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO Bucket Name
MINIO_BUCKET=assbep-media

# MinIO Public URL (for generating file URLs)
MINIO_PUBLIC_URL=http://localhost:9000

# MinIO Console Port
MINIO_CONSOLE_PORT=9001

# =============================================================================
# API CONFIGURATION
# =============================================================================
# API Port
API_PORT=4000

# Node Environment (development, production, test)
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# API Base URL (for generating links)
API_URL=http://localhost:4000

# =============================================================================
# ADMIN BACKOFFICE CONFIGURATION
# =============================================================================
# Admin Port
ADMIN_PORT=3001

# API URL for Admin (backend endpoint)
VITE_API_URL=http://localhost:4000/api

# Admin Title
VITE_APP_TITLE=ASSBEP Admin

# =============================================================================
# PUBLIC WEBSITE CONFIGURATION
# =============================================================================
# Public Website Port
PUBLIC_PORT=3000

# API URL for Public Website (backend endpoint)
VITE_API_URL=http://localhost:4000/api

# Public Website Title
VITE_APP_TITLE=ASSBEP Health Platform

# Google Analytics (optional)
VITE_GA_TRACKING_ID=

# =============================================================================
# EMAIL CONFIGURATION (Optional - for contact form)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@assbep.org

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================
# Max file upload size (in bytes) - 10MB default
MAX_FILE_SIZE=10485760

# Rate limiting (requests per minute)
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# Session secret
SESSION_SECRET=your-session-secret-change-in-production

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Enable detailed SQL logging
DATABASE_LOGGING=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_REGISTRATION=false
ENABLE_PASSWORD_RESET=true
ENABLE_EMAIL_VERIFICATION=false

# =============================================================================
# TIMEZONE & LOCALE
# =============================================================================
TZ=UTC
DEFAULT_LANGUAGE=en
