# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# ⚠️ SECURITY WARNING: Update ALL passwords and secrets before deploying!
# ⚠️ Never commit this file to Git!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=assbep_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123!@#
POSTGRES_DB=assbep_health_production
POSTGRES_PORT=5432

# Database URL for Prisma (use private network or internal service name)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# =============================================================================
# MINIO CONFIGURATION (S3-Compatible Storage)
# =============================================================================
# ⚠️ CRITICAL: Change these credentials in production!
MINIO_ROOT_USER=assbep-admin-2024
MINIO_ROOT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_456!@#

# MinIO Endpoint
# Option 1: Internal Docker network
MINIO_ENDPOINT=minio:9000
# Option 2: Public domain (if exposing MinIO directly)
# MINIO_ENDPOINT=minio.yourdomain.com

MINIO_PORT=443
MINIO_USE_SSL=true

# MinIO Access Key (for API to connect)
MINIO_ACCESS_KEY=assbep-api-key-2024
MINIO_SECRET_KEY=CHANGE_THIS_SECRET_KEY_789!@#

MINIO_BUCKET=assbep-media-production

# MinIO Public URL (for generating file URLs)
# Option 1: CDN URL (recommended)
MINIO_PUBLIC_URL=https://cdn.yourdomain.com
# Option 2: Direct MinIO URL
# MINIO_PUBLIC_URL=https://minio.yourdomain.com
# Option 3: API Proxy
# MINIO_PUBLIC_URL=https://api.yourdomain.com/files

MINIO_CONSOLE_PORT=9001

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_PORT=4000
NODE_ENV=production

# ⚠️ CRITICAL: Generate a strong JWT secret!
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG
JWT_EXPIRES_IN=7d

# CORS Configuration (your actual domains)
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com

# API Base URL
API_URL=https://api.yourdomain.com

# =============================================================================
# ADMIN BACKOFFICE CONFIGURATION
# =============================================================================
ADMIN_PORT=3001

# API URL for Admin
VITE_API_URL=https://api.yourdomain.com/api

VITE_APP_TITLE=ASSBEP Admin

# =============================================================================
# PUBLIC WEBSITE CONFIGURATION
# =============================================================================
PUBLIC_PORT=3000

# API URL for Public Website
VITE_API_URL=https://api.yourdomain.com/api

VITE_APP_TITLE=ASSBEP Health Platform

# Google Analytics
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Use a production email service (SendGrid, AWS SES, etc.)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SENDGRID_API_KEY
SMTP_FROM=noreply@yourdomain.com

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================
# Max file upload size (20MB for production)
MAX_FILE_SIZE=20971520

# Stricter rate limiting for production
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=60

# ⚠️ Generate a strong session secret
# Generate with: openssl rand -base64 64
SESSION_SECRET=REPLACE_WITH_GENERATED_SESSION_SECRET_KEY

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=warn
DATABASE_LOGGING=false

# Optional: Integration with logging services
# SENTRY_DSN=https://your-sentry-dsn
# DATADOG_API_KEY=your-datadog-key

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_REGISTRATION=false
ENABLE_PASSWORD_RESET=true
ENABLE_EMAIL_VERIFICATION=true

# =============================================================================
# TIMEZONE & LOCALE
# =============================================================================
TZ=Africa/Antananarivo
DEFAULT_LANGUAGE=fr

# =============================================================================
# SSL/TLS CERTIFICATES (if handling within containers)
# =============================================================================
# SSL_CERT_PATH=/etc/ssl/certs/cert.pem
# SSL_KEY_PATH=/etc/ssl/private/key.pem

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=assbep-backups

# =============================================================================
# CDN CONFIGURATION (Optional)
# =============================================================================
# CDN_ENABLED=true
# CDN_DOMAIN=cdn.yourdomain.com
# CLOUDFLARE_API_KEY=your-cloudflare-key
