generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String
  role           Role     @default(EDITOR)
  profilePicture String?  @map("profile_picture")
  position       String?
  bio            String?  @db.Text
  showInTeam     Boolean  @default(false) @map("show_in_team")
  linkedin       String?
  twitter        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  articles Article[]

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  EDITOR
  TRANSLATOR
}

model Program {
  id          String   @id @default(uuid())
  slug        String   @unique
  category    String
  image       String?
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  translations ProgramTranslation[]

  @@map("programs")
}

model ProgramTranslation {
  id          String @id @default(uuid())
  programId   String @map("program_id")
  language    String @db.VarChar(5)
  title       String
  description String @db.Text
  content     String? @db.Text

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, language])
  @@map("program_translations")
}

model Article {
  id          String   @id @default(uuid())
  slug        String   @unique
  category    String
  image       String?
  authorId    String?  @map("author_id")
  published   Boolean  @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author       User?                @relation(fields: [authorId], references: [id])
  translations ArticleTranslation[]

  @@map("articles")
}

model ArticleTranslation {
  id        String @id @default(uuid())
  articleId String @map("article_id")
  language  String @db.VarChar(5)
  title     String
  excerpt   String @db.Text
  content   String @db.Text

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, language])
  @@map("article_translations")
}

model Resource {
  id        String   @id @default(uuid())
  type      String // guide, video, document
  fileUrl   String?  @map("file_url")
  published Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations ResourceTranslation[]

  @@map("resources")
}

model ResourceTranslation {
  id          String @id @default(uuid())
  resourceId  String @map("resource_id")
  language    String @db.VarChar(5)
  title       String
  description String @db.Text

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, language])
  @@map("resource_translations")
}

model Partner {
  id      String  @id @default(uuid())
  name    String
  logo    String?
  website String?
  order   Int     @default(0)

  @@map("partners")
}

model Phrase {
  id       String @id @default(uuid())
  key      String
  group    String @default("general")
  language String @db.VarChar(5)
  value    String @db.Text

  @@unique([key, language])
  @@map("phrases")
}

model Media {
  id        String   @id @default(uuid())
  filename  String
  url       String
  type      String // image, document, logo, video
  altText   String?  @map("alt_text")
  size      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("media")
}

model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_requests")
}

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String @db.Text

  @@map("site_settings")
}
