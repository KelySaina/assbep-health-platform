# Public Website Environment Variables
# Copy to public-website/.env for local development

# API Configuration
VITE_API_URL=http://localhost:4000/api

# App Configuration
VITE_APP_TITLE=ASSBEP Health Platform
VITE_APP_DESCRIPTION=Supporting community health and wellness
VITE_APP_URL=http://localhost:3000

# Contact Information
VITE_CONTACT_EMAIL=contact@assbep.org
VITE_CONTACT_PHONE=+261 XX XX XXX XX

# Social Media (optional)
VITE_FACEBOOK_URL=
VITE_TWITTER_URL=
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=

# Environment
VITE_NODE_ENV=development

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_CONTACT_FORM=true
VITE_ENABLE_NEWSLETTER=true

# Analytics
VITE_GA_TRACKING_ID=
VITE_GTM_ID=

# Map Configuration
VITE_GOOGLE_MAPS_API_KEY=
