# Public Website - Production Environment
# Copy to public-website/.env.production

# API Configuration
VITE_API_URL=https://api.yourdomain.com/api

# App Configuration
VITE_APP_TITLE=ASSBEP Health Platform
VITE_APP_DESCRIPTION=Supporting community health and wellness in Madagascar
VITE_APP_URL=https://yourdomain.com

# Contact Information
VITE_CONTACT_EMAIL=contact@yourdomain.com
VITE_CONTACT_PHONE=+261 XX XX XXX XX

# Social Media
VITE_FACEBOOK_URL=https://facebook.com/assbep
VITE_TWITTER_URL=https://twitter.com/assbep
VITE_LINKEDIN_URL=https://linkedin.com/company/assbep
VITE_INSTAGRAM_URL=https://instagram.com/assbep

# Environment
VITE_NODE_ENV=production

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_CONTACT_FORM=true
VITE_ENABLE_NEWSLETTER=true

# Analytics
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXX

# Map Configuration
VITE_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# SEO & Meta
VITE_SITE_NAME=ASSBEP Health Platform
VITE_OG_IMAGE=https://yourdomain.com/og-image.jpg
VITE_TWITTER_HANDLE=@assbep
